<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The probe never talks to the Copilot CLI; CI passes this globally as well
         so the referenced JustyBase.Ai build skips the native CLI download. -->
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\JustyBase.Ai\JustyBase.Ai.csproj" />
  </ItemGroup>
</Project>
