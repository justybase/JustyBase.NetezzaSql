<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>JustyBase.NetezzaSqlParser</RootNamespace>
    <AssemblyName>JustyBase.NetezzaSqlParser</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Superpower" Version="3.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared host-agnostic contracts (word-list seam). Keeps Core out of this
         assembly via the Compile Remove below; packed as a JustyBase.Core
         package dependency. -->
    <ProjectReference Include="JustyBase.Core\JustyBase.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="JustyBase.Netezza\**\*.cs" />
    <Compile Remove="JustyBase.NetezzaCatalogSql\**\*.cs" />
    <Compile Remove="JustyBase.NetezzaDdl\**\*.cs" />
    <Compile Remove="JustyBase.NetezzaSqlLsp\**\*.cs" />
    <Compile Remove="JustyBase.Core\**\*.cs" />
    <Compile Remove="JustyBase.ImportExport\**\*.cs" />
    <Compile Remove="JustyBase.Ai\**\*.cs" />
    <Compile Remove="JustyBase.Ai.Embedded\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="samples\**\*.cs" />
    <Compile Remove="artifacts\**\*.cs" />
    <Compile Remove="tmp_diag\**\*.cs" />
    <Compile Remove="tmp_*\**\*.cs" />
    <Compile Remove="eng\**\*.cs" />
  </ItemGroup>

</Project>
