<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
    <!-- GitHub.Copilot.SDK 1.0.x (Rust runtime bridged via source-generated FFI,
         source-generated JSON) and Microsoft.Extensions.AI 10.x are AOT/trim
         compatible. Verified with analyzers (0 warnings) and a NativeAOT publish probe. -->
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>JustyBase.Ai</PackageId>
    <RootNamespace>JustyBase.Ai</RootNamespace>
    <AssemblyName>JustyBase.Ai</AssemblyName>
    <PackageDescription>UI-agnostic AI chat logic for JustyBase hosts: chat service, tool executor, OpenAI-compatible and Codex backends, prompt building, and chat model contracts.</PackageDescription>
    <PackageTags>ai;chat;copilot;openai;justybase</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="GitHub.Copilot.SDK" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JustyBase.Ai.Embedded\JustyBase.Ai.Embedded.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JustyBase.Ai.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
