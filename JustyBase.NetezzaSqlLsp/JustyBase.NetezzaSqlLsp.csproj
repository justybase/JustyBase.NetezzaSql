<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JustyBase.NetezzaSqlLsp</RootNamespace>
    <AssemblyName>JustyBase.NetezzaSqlLsp</AssemblyName>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IsPackable>false</IsPackable>
    <!-- Superpower is a third-party parser dependency that emits an aggregate
         trim warning under NativeAOT; the LSP code itself remains AOT-safe. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JustyBase.NetezzaSqlParser.csproj" />
    <!-- Shared word-list contract + headless service (ISqlDbWordListProvider seam). -->
    <ProjectReference Include="..\JustyBase.Core\JustyBase.Core.csproj" />
  </ItemGroup>

</Project>
